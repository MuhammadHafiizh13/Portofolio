<!-- views/partials/loading-screen.ejs -->
<div id="loading-screen" class="loading-screen">
  <div class="solar-loader">
    <div class="sun"></div>
    <div class="orbit orbit-1">
      <div class="planet planet-mercury"></div>
    </div>
    <div class="orbit orbit-2">
      <div class="planet planet-venus"></div>
    </div>
    <div class="orbit orbit-3">
      <div class="planet planet-earth"></div>
    </div>
  </div>

  <div id="loading-name" class="loading-screen__name">
    <%= profile.name %>
  </div>

  <div id="loading-subtitle" class="loading-screen__subtitle">
    <%= profile.role %>
  </div>

  <div class="loading-screen__progress-container">
    <div id="loading-progress-fill" class="loading-screen__progress-fill"></div>
  </div>

  <div id="loading-percent" class="loading-screen__percent">0%</div>
</div>
