<!-- ============================================================
     partials/header.ejs — Navigasi utama (dipakai di semua halaman)
     Data yang tersedia:
       - profile.activePage  : path halaman aktif (dari server.js)
       - profile.shortName   : nama singkat untuk logo
     ============================================================ -->
<%
  // Daftar menu navigasi (label + path)
  const navLinks = [
    { label: 'Beranda', path: '/' },
    { label: 'Tentang', path: '/about' },
    { label: 'Proyek',  path: '/projects' },
    { label: 'Kontak',  path: '/contact' }
  ];

  // Fungsi kecil untuk menentukan class link (aktif vs tidak aktif)
  function linkClass(path) {
    return activePage === path
      ? 'text-indigo-600 dark:text-indigo-400 font-semibold bg-indigo-50 dark:bg-indigo-500/10'
      : 'text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800/60';
  }
%>

<!-- Progress bar scroll (lebar diatur oleh main.js) -->
<div id="scroll-progress" class="fixed top-0 left-0 h-1 w-0 z-[70] bg-gradient-to-r from-indigo-500 via-violet-500 to-fuchsia-500"></div>

<!-- Navbar: fixed di atas, transparan + blur -->
<header id="navbar" class="fixed top-0 inset-x-0 z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white hover:opacity-80 transition-opacity">
        <%= profile.shortName %><span class="text-indigo-600 dark:text-indigo-400">.</span>
      </a>

      <!-- Menu desktop -->
      <ul class="hidden md:flex items-center gap-1">
        <% navLinks.forEach(link => { %>
          <li>
            <a href="<%= link.path %>"
               class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 <%= linkClass(link.path) %>">
              <%= link.label %>
            </a>
          </li>
        <% }) %>
      </ul>

      <!-- Tombol aksi: toggle tema + tombol Hire Me + menu mobile -->
      <div class="flex items-center gap-2">
        <!-- Toggle tema terang/gelap -->
        <button id="theme-toggle" type="button" aria-label="Ganti mode terang/gelap"
          class="p-2.5 rounded-full text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </button>

        <!-- CTA desktop -->
        <a href="/contact" class="hidden md:inline-flex items-center px-5 py-2.5 rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 text-white text-sm font-semibold hover:shadow-lg hover:shadow-indigo-500/30 hover:-translate-y-0.5 transition-all duration-300">
          Hire Me
        </a>

        <!-- Tombol hamburger (mobile) -->
        <button id="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false"
          class="md:hidden p-2.5 rounded-full text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <svg id="icon-burger" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Menu mobile (dropdown) -->
    <div id="mobile-menu" class="md:hidden hidden pb-4">
      <ul class="space-y-1 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-2 shadow-xl">
        <% navLinks.forEach(link => { %>
          <li>
            <a href="<%= link.path %>"
               class="block px-4 py-3 rounded-xl text-sm font-medium transition-colors <%= linkClass(link.path) %>">
              <%= link.label %>
            </a>
          </li>
        <% }) %>
        <li>
          <a href="/contact" class="block px-4 py-3 rounded-xl text-sm font-semibold text-center bg-gradient-to-r from-indigo-600 to-violet-600 text-white">
            Hire Me
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>
