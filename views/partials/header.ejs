<!-- partials/header.ejs — Navbar -->
<%
  const navLinks = [
    { label: 'Beranda', path: '/' },
    { label: 'Tentang', path: '/about' },
    { label: 'Proyek',  path: '/projects' },
    { label: 'Kontak',  path: '/contact' }
  ];
  function linkClass(path) {
    return activePage === path
      ? 'text-[#f97316] font-medium nav-link active'
      : 'text-slate-500 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white nav-link';
  }
%>

<div id="scroll-progress" class="fixed top-0 left-0 h-[2px] w-0 z-[70] bg-gradient-to-r from-[#f97316] via-[#fb923c] to-[#ef4444]"></div>

<header id="navbar" class="fixed top-0 inset-x-0 z-50 h-16 bg-white/80 dark:bg-[rgba(9,9,11,0.8)] backdrop-blur-xl border-b border-black/5 dark:border-white/5 transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-full">
    <div class="flex items-center justify-between h-full">
      <a href="/" class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white hover:opacity-80 transition-opacity">
        <%= profile.shortName %><span class="text-[#f97316]">.</span>
      </a>

      <ul class="hidden md:flex items-center gap-1">
        <% navLinks.forEach(link => { %>
          <li>
            <a href="<%= link.path %>" class="px-4 py-2 rounded-lg text-sm transition-all duration-200 <%= linkClass(link.path) %>">
              <%= link.label %>
            </a>
          </li>
        <% }) %>
      </ul>

      <div class="flex items-center gap-2">
        <button id="theme-toggle" type="button" aria-label="Ganti tema"
          class="p-2.5 rounded-xl text-slate-500 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </button>

        <a href="/contact" class="hidden md:inline-flex items-center px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-[#f4f4f5] text-white dark:text-[#18181b] text-sm font-semibold hover:bg-slate-800 dark:hover:bg-white hover:shadow-lg transition-all duration-300">
          Hire Me
        </a>

        <button id="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false"
          class="md:hidden p-2.5 rounded-xl text-slate-500 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
          <svg id="icon-burger" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<div id="mobile-overlay" class="mobile-overlay"></div>

<div id="mobile-panel" class="mobile-panel">
  <div class="flex items-center justify-between mb-8">
    <span class="text-lg font-semibold text-slate-900 dark:text-white">Menu</span>
    <button id="mobile-close-btn" type="button" class="p-2 rounded-xl text-slate-500 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <ul class="space-y-1">
    <% navLinks.forEach(link => { %>
      <li>
        <a href="<%= link.path %>"
           class="block px-4 py-3 rounded-xl text-sm font-medium transition-colors <%= activePage === link.path ? 'text-[#f97316] bg-[#f97316]/5 dark:bg-[#f97316]/10' : 'text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5' %>">
          <%= link.label %>
        </a>
      </li>
    <% }) %>
    <li class="pt-3">
      <a href="/contact" class="block px-4 py-3 rounded-xl text-sm font-semibold text-center bg-[#f97316] text-white">
        Hire Me
      </a>
    </li>
  </ul>
</div>

<script>
  document.getElementById('mobile-close-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-panel')?.classList.remove('active');
    document.getElementById('mobile-overlay')?.classList.remove('active');
    document.getElementById('icon-burger')?.classList.remove('hidden');
    document.getElementById('icon-close')?.classList.add('hidden');
    document.body.style.overflow = '';
  });
</script>
