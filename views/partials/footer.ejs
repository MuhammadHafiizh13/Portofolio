<!-- partials/footer.ejs -->
<footer class="border-t border-slate-200 dark:border-white/[0.06] bg-slate-50 dark:bg-[#0c0c0e]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid gap-10 md:grid-cols-3">
    <div>
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#f97316] to-[#ef4444] flex items-center justify-center">
          <span class="text-white text-xs font-bold"><%= profile.shortName.charAt(0) %></span>
        </div>
        <span class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white"><%= profile.shortName %><span class="text-[#f97316]">.</span></span>
      </a>
      <p class="mt-3 text-sm text-slate-500 dark:text-[#71717a] leading-relaxed max-w-xs"><%= profile.tagline %></p>
      <div class="mt-5 flex items-center gap-3">
        <% Object.values(profile.socials).forEach(social => { %>
          <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= social.label %>"
            class="w-10 h-10 rounded-xl flex items-center justify-center bg-white dark:bg-zinc-900 border border-slate-200 dark:border-white/[0.06] text-slate-400 dark:text-[#52525b] hover:text-white hover:bg-[#f97316]/10 hover:border-[#f97316]/30 transition-all duration-200">
            <span class="text-sm font-semibold"><%= social.label.charAt(0) %></span>
          </a>
        <% }) %>
      </div>
    </div>
    <div class="md:justify-self-center">
      <h3 class="text-[11px] font-medium uppercase tracking-[0.2em] text-slate-400 dark:text-[#52525b] mb-4">Navigasi</h3>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/" class="text-slate-500 dark:text-[#71717a] hover:text-[#fb923c] transition-colors">Beranda</a></li>
        <li><a href="/about" class="text-slate-500 dark:text-[#71717a] hover:text-[#fb923c] transition-colors">Tentang Saya</a></li>
        <li><a href="/projects" class="text-slate-500 dark:text-[#71717a] hover:text-[#fb923c] transition-colors">Portofolio</a></li>
        <li><a href="/contact" class="text-slate-500 dark:text-[#71717a] hover:text-[#fb923c] transition-colors">Kontak</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-[11px] font-medium uppercase tracking-[0.2em] text-slate-400 dark:text-[#52525b] mb-4">Kontak</h3>
      <ul class="space-y-3 text-sm">
        <li class="flex items-start gap-3 text-slate-500 dark:text-[#71717a]">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 mt-1" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
          <span><%= profile.location %></span>
        </li>
        <li class="flex items-start gap-3">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 mt-1 text-slate-500 dark:text-[#71717a]" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" /><path d="M22 6l-10 7L2 6" /></svg>
          <a href="mailto:<%= profile.email %>" class="text-slate-500 dark:text-[#71717a] hover:text-[#fb923c] transition-colors"><%= profile.email %></a>
        </li>
        <li class="flex items-start gap-3 text-slate-500 dark:text-[#71717a]">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 mt-1" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
          <span><%= profile.phone %></span>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200 dark:border-white/[0.06]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-slate-400 dark:text-[#52525b]">
      <p>© <%= currentYear %> <%= profile.name %>. Semua hak dilindungi.</p>
      <p>dibuat oleh Muhammad Al Hafiizh Ar Raafi.</p>
    </div>
  </div>
</footer>
