<!-- ============================================================
     partials/footer.ejs — Footer (dipakai di semua halaman)
     Data: profile (nama, sosmed, email), currentYear
     ============================================================ -->
<footer class="border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid gap-10 md:grid-cols-3">
    <!-- Kolom 1: brand & sosmed -->
    <div>
      <a href="/" class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        <%= profile.shortName %><span class="text-indigo-600 dark:text-indigo-400">.</span>
      </a>
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 leading-relaxed max-w-xs">
        <%= profile.tagline %>
      </p>
      <div class="mt-5 flex items-center gap-3">
        <% Object.values(profile.socials).forEach(social => { %>
          <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= social.label %>"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-300 hover:text-white hover:bg-indigo-600 hover:border-indigo-600 transition-all duration-200">
            <span class="text-sm font-semibold"><%= social.label.charAt(0) %></span>
          </a>
        <% }) %>
      </div>
    </div>

    <!-- Kolom 2: navigasi cepat -->
    <div class="md:justify-self-center">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-4">Navigasi</h3>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Beranda</a></li>
        <li><a href="/about" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Tentang Saya</a></li>
        <li><a href="/projects" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Portofolio</a></li>
        <li><a href="/contact" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Kontak</a></li>
      </ul>
    </div>

    <!-- Kolom 3: kontak -->
    <div>
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-4">Kontak</h3>
      <ul class="space-y-3 text-sm">
        <li class="flex items-start gap-3 text-slate-500 dark:text-slate-400">
          <span class="mt-0.5">📍</span>
          <span><%= profile.location %></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5">✉️</span>
          <a href="mailto:<%= profile.email %>" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
            <%= profile.email %>
          </a>
        </li>
        <li class="flex items-start gap-3 text-slate-500 dark:text-slate-400">
          <span class="mt-0.5">📞</span>
          <span><%= profile.phone %></span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Baris bawah: copyright -->
  <div class="border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-slate-500 dark:text-slate-400">
      <p>© <%= currentYear %> <%= profile.name %>. Semua hak dilindungi.</p>
      <p>dibuat oleh Muhammad Al Hafiizh Ar Raafi.</p>
    </div>
  </div>
</footer>
