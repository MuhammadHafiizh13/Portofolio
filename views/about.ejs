<!-- ============================================================
     Halaman TENTANG SAYA (views/about.ejs)
     Data dari Controller: profile
     ============================================================ -->

<!-- Header halaman -->
<section class="relative overflow-hidden pt-32 md:pt-36 pb-12">
  <div class="absolute inset-0 bg-grid opacity-40 dark:opacity-20"></div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-indigo-600 dark:text-indigo-400 font-semibold">Tentang Saya</p>
    <h1 class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      Kenali saya lebih dekat
    </h1>
    <p class="mt-4 text-slate-500 dark:text-slate-400 max-w-2xl">
      Selamat datang! Berikut adalah perjalanan, keahlian, dan kisah di balik karya-karya saya.
    </p>
  </div>
</section>

<!-- ===================== BIODATA + BIO ===================== -->
<section class="pb-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-5 gap-10">
  <!-- KIRI: Kartu biodata -->
  <aside class="lg:col-span-2 reveal">
    <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm lg:sticky lg:top-24">
      <div class="flex items-center gap-5">
        <img src="/img/ganteng.jpeg" alt="Foto <%= profile.name %>" class="w-24 h-24 rounded-2xl object-cover ring-2 ring-indigo-500/30" />
        <div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white"><%= profile.name %></h3>
          <p class="text-sm text-indigo-600 dark:text-indigo-400 font-medium"><%= profile.role %></p>
          <p class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <%= profile.available ? 'Tersedia' : 'Tidak tersedia' %>
          </p>
        </div>
      </div>

      <!-- Detail kontak -->
      <div class="mt-6 space-y-3.5 text-sm">
        <div class="flex items-center gap-3 text-slate-600 dark:text-slate-300">
          <span class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center">📍</span>
          <span><%= profile.location %></span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center">✉️</span>
          <a href="mailto:<%= profile.email %>" class="text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"><%= profile.email %></a>
        </div>
        <div class="flex items-center gap-3 text-slate-600 dark:text-slate-300">
          <span class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center">📞</span>
          <span><%= profile.phone %></span>
        </div>
      </div>

      <!-- Tombol aksi -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contact" class="flex-1 text-center px-4 py-2.5 rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 text-white text-sm font-semibold hover:shadow-md hover:shadow-indigo-500/30 hover:-translate-y-0.5 transition-all duration-200">
          Hubungi Saya
        </a>
        <a href="<%= profile.socials.github.url %>" target="_blank" rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-full border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          GitHub
        </a>
      </div>
    </div>
  </aside>

  <!-- KANAN: Latar belakang -->
  <div class="lg:col-span-3">
    <h2 class="reveal text-2xl font-bold text-slate-900 dark:text-white">Latar Belakang</h2>
    <% profile.bio.forEach(paragraph => { %>
      <p class="reveal mt-5 text-slate-600 dark:text-slate-300 leading-relaxed"><%= paragraph %></p>
    <% }) %>

    <!-- Statistik singkat -->
    <div class="mt-10 grid grid-cols-3 gap-4 reveal">
      <div class="text-center p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
        <p class="text-3xl font-extrabold text-gradient">3</p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Tahun Pengalaman</p>
      </div>
      <div class="text-center p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
        <p class="text-3xl font-extrabold text-gradient">2+</p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Proyek Selesai</p>
      </div>
      <div class="text-center p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
        <p class="text-3xl font-extrabold text-gradient">1</p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Klien Puas</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== HARD SKILLS ===================== -->
<section class="py-20 bg-slate-50 dark:bg-slate-900/40 border-y border-slate-200 dark:border-slate-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center reveal">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-indigo-100 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">Keahlian</span>
      <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">Hard Skills</h2>
      <p class="mt-3 text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">
        Teknologi dan tools yang saya gunakan sehari-hari untuk membangun produk digital.
      </p>
    </div>

    <div class="mt-12 space-y-6">
      <% profile.hardSkills.forEach(skill => { %>
        <div class="reveal">
          <div class="flex justify-between items-center text-sm font-medium mb-2">
            <span class="text-slate-800 dark:text-slate-200"><%= skill.name %></span>
            <span class="text-indigo-600 dark:text-indigo-400"><%= skill.level %>%</span>
          </div>
          <div class="h-2.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
            <!-- lebar diisi oleh main.js saat elemen terlihat di layar -->
            <div class="skill-bar-fill h-full rounded-full bg-gradient-to-r from-indigo-500 to-violet-500 transition-all duration-1000 ease-out"
              data-level="<%= skill.level %>" style="width: 0"></div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ===================== SOFT SKILLS ===================== -->
<section class="py-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center reveal">
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-indigo-100 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">Keahlian</span>
    <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">Soft Skills</h2>
    <p class="mt-3 text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">
      Kemampuan interpersonal yang membuat saya bekerja lebih baik dalam tim.
    </p>
  </div>

  <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <%
      // Ikon SVG untuk masing-masing soft skill (sesuai urutan di profileModel)
      const softIcons = [
        '<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />',
        '<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />',
        '<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />',
        '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />'
      ];
    %>
    <% profile.softSkills.forEach((skill, index) => { %>
      <div class="reveal group p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-indigo-400 hover:shadow-lg hover:shadow-indigo-500/10 hover:-translate-y-1 transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white shadow-md shadow-indigo-500/30 group-hover:scale-110 transition-transform duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6">
            <%- softIcons[index] %>
          </svg>
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white"><%= skill.name %></h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed"><%= skill.desc %></p>
      </div>
    <% }) %>
  </div>
</section>

<!-- ===================== TIMELINE ===================== -->
<section class="pb-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center reveal">
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-indigo-100 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">Perjalanan</span>
    <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">Pendidikan &amp; Pengalaman</h2>
  </div>

  <ol class="relative mt-12 ml-3 border-l-2 border-slate-200 dark:border-slate-800 space-y-10">
    <% profile.timeline.forEach(item => { %>
      <li class="reveal relative pl-8">
        <!-- Titik pada garis waktu -->
        <span class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-indigo-500 ring-4 ring-indigo-500/20"></span>
        <h3 class="mt-1.5 text-lg font-bold text-slate-900 dark:text-white"><%= item.title %></h3>
        <p class="mt-1.5 text-slate-500 dark:text-slate-400 leading-relaxed"><%= item.desc %></p>
      </li>
    <% }) %>
  </ol>
</section>
