<!-- views/projects.ejs -->
<section class="relative overflow-hidden pt-32 md:pt-36 pb-12">
  <div class="hero-bg-radial absolute inset-0"></div>
  <div class="hero-bg-radial absolute inset-0 bg-grid opacity-40"></div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="inline-block px-4 py-1.5 rounded-lg text-[10px] font-medium uppercase tracking-[0.2em] bg-[#f97316]/10 text-[#fb923c] border border-[#f97316]/20">Portofolio</span>
    <h1 class="mt-4 text-4xl sm:text-5xl font-semibold tracking-tight text-slate-900 dark:text-[#f4f4f5]">Proyek yang Pernah Saya Kerjakan</h1>
    <p class="mt-4 text-slate-500 dark:text-[#a1a1aa] max-w-2xl mx-auto">Kumpulan proyek yang menunjukkan kemampuan saya dalam membangun aplikasi web — dari backend, database, hingga antarmuka pengguna.</p>
  </div>
</section>
<section class="pb-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="grid md:grid-cols-2 gap-6">
    <% projects.forEach(project => { %>
      <%- include('partials/projectCard', { project }) %>
    <% }) %>
  </div>
  <% if (projects.length === 0) { %>
    <div class="text-center py-20">
      <p class="text-5xl">📂</p>
      <p class="mt-4 text-slate-500 dark:text-[#a1a1aa]">Belum ada proyek. Tambahkan data pada <code class="text-[#fb923c]">data/projects.json</code></p>
    </div>
  <% } %>
</section>
