<!-- ============================================================
     Halaman BERANDA (views/index.ejs)
     Data dari Controller: profile, featuredProjects
     ============================================================ -->

<!-- ===================== HERO SECTION ===================== -->
<section class="relative overflow-hidden">
  <!-- Dekorasi latar belakang -->
  <div class="absolute inset-0 bg-grid opacity-60 dark:opacity-30"></div>
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-500/20 dark:bg-indigo-500/10 rounded-full blur-3xl"></div>
  <div class="absolute top-40 -right-32 w-[28rem] h-[28rem] bg-violet-500/20 dark:bg-violet-500/10 rounded-full blur-3xl"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 md:pt-40 pb-16 md:pb-24 grid lg:grid-cols-2 gap-14 items-center">
    <!-- KIRI: Teks perkenalan -->
    <div class="reveal">
      <!-- Badge status -->
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-100 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Tersedia untuk proyek baru
      </span>

      <!-- Judul utama -->
      <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
        Halo, saya<br />
        <span class="text-gradient"><%= profile.name %></span> 👋
      </h1>

      <!-- Efek ketikan (typing effect), data diambil dari profile.typedRoles -->
      <p class="mt-5 text-xl sm:text-2xl font-semibold text-slate-600 dark:text-slate-300 min-h-8">
        Saya <span id="typed" data-roles='<%= JSON.stringify(profile.typedRoles) %>' class="text-indigo-600 dark:text-indigo-400"></span><span class="animate-pulse">|</span>
      </p>

      <p class="mt-4 text-slate-600 dark:text-slate-400 leading-relaxed max-w-xl">
        <%= profile.tagline %>
      </p>

      <!-- Tombol CTA -->
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/projects"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-semibold hover:shadow-lg hover:shadow-indigo-500/40 hover:-translate-y-0.5 transition-all duration-300">
          Lihat Proyek Saya
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a href="/contact"
          class="inline-flex items-center px-7 py-3.5 rounded-full border-2 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 font-semibold hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 transition-all duration-300">
          Hubungi Saya
        </a>
      </div>

      <!-- Media sosial -->
      <div class="mt-9 flex items-center gap-3">
        <span class="text-sm text-slate-400">Ikuti saya:</span>
        <div class="flex items-center gap-2">
          <% Object.values(profile.socials).forEach(social => { %>
            <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= social.label %>"
              class="w-9 h-9 rounded-full flex items-center justify-center border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:text-white hover:bg-indigo-600 hover:border-indigo-600 hover:-translate-y-0.5 transition-all duration-200">
              <span class="text-xs font-bold"><%= social.label.charAt(0) %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- KANAN: Foto profil dengan badge teknologi -->
    <div class="reveal relative flex justify-center lg:justify-end">
      <div class="relative w-64 h-64 sm:w-80 sm:h-80">
        <!-- Efek glow di belakang foto -->
        <div class="absolute -inset-4 bg-gradient-to-br from-indigo-500 via-violet-500 to-fuchsia-500 rounded-[2.5rem] opacity-25 blur-2xl"></div>

        <img src="/img/ganteng.jpeg" alt="Foto <%= profile.name %>"
          class="relative w-full h-full rounded-[2.5rem] object-cover ring-1 ring-slate-200 dark:ring-slate-700 shadow-2xl" />

        <!-- Badge teknologi mengambang -->
        <div class="animate-float absolute -left-4 sm:-left-8 top-8 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-lg text-sm font-semibold text-slate-800 dark:text-slate-200">
          <span>🚀</span> Node.js
        </div>
        <div class="animate-float absolute -right-3 sm:-right-6 bottom-24 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-lg text-sm font-semibold text-slate-800 dark:text-slate-200" style="animation-delay: 1.2s">
          <span>⚡</span> Express
        </div>
        <div class="animate-float absolute -bottom-5 left-8 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-lg text-sm font-semibold text-slate-800 dark:text-slate-200" style="animation-delay: 2.4s">
          <span>🎨</span> EJS + Tailwind
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== STRIP TEKNOLOGI ===================== -->
<section class="border-y border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <p class="text-center text-xs font-bold uppercase tracking-widest text-slate-400 mb-6">Teknologi yang saya kuasai</p>
    <div class="flex flex-wrap justify-center gap-3">
      <% ['JavaScript', 'Node.js', 'Express.js', 'EJS', 'Tailwind CSS', 'MySQL', 'Dart', 'Flutter', 'Git & GitHub'].forEach(tech => { %>
        <span class="px-4 py-2 rounded-full text-sm font-medium bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
          <%= tech %>
        </span>
      <% }) %>
    </div>
  </div>
</section>

<!-- ===================== PROYEK UNGGULAN ===================== -->
<section class="py-20 md:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center reveal">
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold bg-indigo-100 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">
      Proyek Pilihan
    </span>
    <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      Beberapa Proyek Terbaru
    </h2>
    <p class="mt-3 text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">
      Berikut adalah beberapa proyek unggulan yang pernah saya kerjakan. Klik kartu untuk melihat lebih detail.
    </p>
  </div>

  <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% featuredProjects.forEach(project => { %>
      <%- include('partials/projectCard', { project }) %>
    <% }) %>
  </div>

  <div class="mt-12 text-center">
    <a href="/projects"
      class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border-2 border-indigo-600 text-indigo-600 dark:text-indigo-400 font-semibold hover:bg-indigo-600 hover:text-white transition-all duration-300">
      Lihat Semua Proyek
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</section>

<!-- ===================== BANNER CTA ===================== -->
<section class="pb-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="reveal relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-violet-600 to-fuchsia-600 px-6 sm:px-12 py-14 text-center text-white">
    <!-- Dekorasi lingkaran -->
    <div class="absolute -top-16 -right-16 w-56 h-56 bg-white/10 rounded-full blur-2xl"></div>
    <div class="absolute -bottom-20 -left-10 w-64 h-64 bg-black/10 rounded-full blur-2xl"></div>

    <div class="relative">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Punya Proyek Menarik? 🤝</h2>
      <p class="mt-3 max-w-xl mx-auto text-indigo-100 leading-relaxed">
        Mari diskusikan ide Anda! Saya siap membantu mewujudkan website atau aplikasi yang Anda impikan.
      </p>
      <a href="/contact"
        class="mt-8 inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-white text-indigo-700 font-bold hover:scale-105 hover:shadow-2xl transition-transform duration-200">
        Mulai Percakapan
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
      </a>
    </div>
  </div>
</section>
