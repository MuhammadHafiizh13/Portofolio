<!-- views/index.ejs — BERANDA -->

<!-- ===================== HERO SECTION ===================== -->
<section class="relative min-h-screen flex items-center overflow-hidden">
  <div class="hero-bg-radial absolute inset-0"></div>
  <div class="hero-bg-radial absolute inset-0 bg-grid opacity-60"></div>
  <div id="hero-particles" class="absolute inset-0 pointer-events-none"></div>

  <!-- 3D Dotted Globe -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none" id="globe-wrap">
    <div class="absolute w-[280px] h-[280px] sm:w-[350px] sm:h-[350px] lg:w-[500px] lg:h-[500px] rounded-full bg-[#f97316]/[0.08] blur-[60px]"></div>
    <canvas id="globe" class="relative z-[1]"></canvas>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 md:pt-40 pb-16 w-full">
    <div class="grid lg:grid-cols-12 gap-12 items-center">

      <!-- KOLOM KIRI -->
      <div class="lg:col-span-7">
        <div class="hero-stagger stagger-1">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[11px] font-medium uppercase tracking-[0.15em] border border-[#f97316]/20 bg-[#f97316]/5 text-[#fb923c]">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            Tersedia untuk proyek baru
          </span>
        </div>

        <h1 class="hero-stagger stagger-2 mt-6 text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-slate-900 dark:text-[#f4f4f5] leading-[1.08]">
          Halo, saya<br />
          <span class="text-gradient"><%= profile.name %></span>
        </h1>

        <p class="hero-stagger stagger-3 mt-5 text-xl sm:text-2xl font-medium text-slate-600 dark:text-zinc-300 min-h-8">
          Saya <span id="typed" data-roles='<%= JSON.stringify(profile.typedRoles) %>' class="text-[#fb923c]"></span><span class="animate-pulse text-[#fb923c]">|</span>
        </p>

        <p class="hero-stagger stagger-4 mt-4 text-slate-500 dark:text-[#a1a1aa] leading-relaxed max-w-lg">
          <%= profile.tagline %>
        </p>

        <div class="hero-stagger stagger-5 mt-8 flex flex-wrap gap-4">
          <a href="/projects"
            class="btn-shimmer inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-slate-900 dark:bg-[#f4f4f5] text-white dark:text-[#18181b] text-sm font-semibold hover:bg-slate-800 dark:hover:bg-white hover:shadow-lg hover:shadow-orange-500/10 hover:-translate-y-0.5 transition-all duration-300">
            Lihat Proyek Saya
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="/contact"
            class="inline-flex items-center px-7 py-3.5 rounded-xl border border-slate-300 dark:border-white/10 text-slate-600 dark:text-[#a1a1aa] text-sm font-semibold hover:text-[#f97316] hover:border-[#f97316]/30 transition-all duration-300">
            Hubungi Saya
          </a>
        </div>

        <div class="hero-stagger stagger-6 mt-9 flex items-center gap-3">
          <span class="text-sm text-slate-400 dark:text-[#52525b]">Ikuti saya:</span>
          <div class="flex items-center gap-2">
            <% Object.values(profile.socials).forEach(social => { %>
              <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= social.label %>"
                class="w-9 h-9 rounded-xl flex items-center justify-center border border-slate-200 dark:border-white/[0.06] text-slate-400 dark:text-[#52525b] hover:text-white hover:bg-[#f97316]/10 hover:border-[#f97316]/30 hover:-translate-y-0.5 transition-all duration-200">
                <span class="text-xs font-bold"><%= social.label.charAt(0) %></span>
              </a>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- KOLOM KANAN — Stat cards -->
      <div class="lg:col-span-5 space-y-4">
        <div class="hero-stagger-right stagger-4 glass-card p-6 animate-border-glow">
          <div class="flex items-start justify-between">
            <div class="stat-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="#f97316" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
              </svg>
            </div>
            <span class="text-[10px] font-medium uppercase tracking-[0.15em] text-slate-400 dark:text-[#71717a]">Total Proyek</span>
          </div>
          <p class="mt-4 text-3xl font-semibold text-slate-900 dark:text-[#f4f4f5]" data-count data-target="2" data-suffix="+">0</p>
          <p class="mt-1 text-sm text-slate-400 dark:text-[#52525b]">Proyek selesai</p>
        </div>

        <div class="hero-stagger-right stagger-5 glass-card p-6">
          <div class="flex items-start justify-between">
            <div class="stat-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="#10b981" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="text-[10px] font-medium uppercase tracking-[0.15em] text-slate-400 dark:text-[#71717a]">Pengalaman</span>
          </div>
          <p class="mt-4 text-3xl font-semibold text-slate-900 dark:text-[#f4f4f5]" data-count data-target="3" data-suffix=" Tahun">0</p>
          <p class="mt-1 text-sm text-slate-400 dark:text-[#52525b]">Pengalaman pengembangan</p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="hero-stagger-right stagger-6 glass-card p-5">
            <div class="stat-icon-box w-9 h-9">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="#f97316" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128H5.228A2 2 0 015 17.119V5a2 2 0 012.228-1.983" />
              </svg>
            </div>
            <p class="mt-3 text-2xl font-semibold text-slate-900 dark:text-[#f4f4f5]" data-count data-target="1">0</p>
            <p class="mt-0.5 text-[11px] text-slate-400 dark:text-[#52525b]">Klien puas</p>
          </div>

          <div class="hero-stagger-right stagger-7 glass-card p-5">
            <div class="stat-icon-box w-9 h-9">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="#10b981" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
              </svg>
            </div>
            <p class="mt-3 text-2xl font-semibold text-slate-900 dark:text-[#f4f4f5]">9+</p>
            <p class="mt-0.5 text-[11px] text-slate-400 dark:text-[#52525b]">Teknologi</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 inset-x-0 border-t border-slate-200 dark:border-white/5"></div>
</section>

<!-- DIPERCAYA OLEH -->
<section class="py-12 border-b border-slate-200 dark:border-white/5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-center text-[10px] font-medium uppercase tracking-[0.2em] text-slate-400 dark:text-[#52525b] mb-6">Dipercaya oleh berbagai teknologi</p>
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
      <% ['JavaScript', 'Node.js', 'Express.js', 'Tailwind CSS', 'MySQL', 'Flutter', 'Git'].forEach(tech => { %>
        <span class="brand-logo text-sm font-medium text-slate-400 dark:text-[#52525b] hover:text-slate-900 dark:hover:text-white transition-all cursor-default">
          <%= tech %>
        </span>
      <% }) %>
    </div>
  </div>
</section>

<!-- PROYEK UNGGULAN -->
<section class="py-20 md:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center reveal">
    <span class="inline-block px-4 py-1.5 rounded-lg text-[10px] font-medium uppercase tracking-[0.2em] bg-[#f97316]/10 text-[#fb923c] border border-[#f97316]/20">
      Proyek Pilihan
    </span>
    <h2 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight text-slate-900 dark:text-[#f4f4f5]">
      Beberapa Proyek Terbaru
    </h2>
    <p class="mt-3 text-slate-500 dark:text-[#a1a1aa] max-w-2xl mx-auto">
      Berikut adalah beberapa proyek unggulan yang pernah saya kerjakan. Klik kartu untuk melihat lebih detail.
    </p>
  </div>

  <div class="mt-12 grid md:grid-cols-2 gap-6">
    <% featuredProjects.forEach(project => { %>
      <%- include('partials/projectCard', { project }) %>
    <% }) %>
  </div>

  <div class="mt-12 text-center">
    <a href="/projects"
      class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-[#f97316]/30 text-[#fb923c] text-sm font-semibold hover:bg-[#f97316]/10 transition-all duration-300">
      Lihat Semua Proyek
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</section>

<!-- BANNER CTA -->
<section class="pb-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="reveal relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#ff5722] to-[#ff9800] shadow-[0_20px_50px_rgba(255,87,34,0.3)]">
    <!-- Elemen dekoratif: blob organik -->
    <div class="cta-blob cta-blob-1" aria-hidden="true"></div>
    <div class="cta-blob cta-blob-2" aria-hidden="true"></div>

    <div class="relative flex flex-col-reverse md:flex-row items-center justify-between gap-8 px-6 sm:px-10 lg:px-14 py-12 sm:py-14 md:min-h-[420px] text-center md:text-left">
      <!-- Teks -->
      <div class="max-w-xl">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white leading-[1.2]">
          Punya Proyek Menarik?
        </h2>
        <p class="mt-4 text-base sm:text-lg text-orange-50/90 leading-relaxed max-w-[90%] mx-auto md:mx-0">
          Mari berdiskusi dan wujudkan ide kreatif Anda menjadi sesuatu yang luar biasa bersama saya.
        </p>
        <a href="/contact" class="cta-button mt-7">
          Mulai Percakapan
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
          </svg>
        </a>
      </div>

      <!-- Gambar -->
      <div class="shrink-0 pointer-events-none" aria-hidden="true">
        <img src="/img/cta-hand.png" alt="" loading="lazy" width="256" height="256"
          class="cta-hand w-40 h-40 sm:w-56 sm:h-56 lg:w-64 lg:h-64 object-contain opacity-80" />
      </div>
    </div>
  </div>
</section>
